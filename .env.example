# --- Приложение ---
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Локальная модель: текст договора эту машину не покидает ---
# Значение по умолчанию совпадает с config/providers.yaml.
# Сменить модель: строка ниже (перекрывает yaml). Потом: ollama pull <имя>
# Вердикт по договору ставит матрица правил и от модели не зависит. Модель
# читает договор и вытаскивает из него стороны и адреса кошельков, а также
# разбирает оговорки с нестандартной формулировкой. Проверить свою модель:
#   python -m scripts.eval_llm --model <имя>
# Опорная модель и требования к ней — в README.md
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.3:70b
LLM_TEMPERATURE=0.0
OLLAMA_TIMEOUT_S=300
# Договор длиннее 24 000 знаков идёт в модель окнами с перекрытием.
# Потолок числа окон: непрочитанная часть честно названа в заключении.
LLM_MAX_WINDOWS=6

# --- Эмбеддинги корпуса норм ---
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=legal_norms
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DENSE_SEARCH=false

# ---------------------------------------------------------------------------
# КЛЮЧИ ВНЕШНИХ СЕРВИСОВ
#
# Наружу уходят три идентификатора: адрес кошелька, ИНН и наименование
# иностранной стороны. Текст договора не уходит никуда.
#
# Пустой ключ — не поломка: заключение соберётся, а в отчёте будет написано,
# что по этому источнику сверка не выполнена. Перечень ключей — в README.md.
# Проверить, что видно из вашей сети:  python -m scripts.check_sources
# ---------------------------------------------------------------------------

# --- Кошелёк: коммерческий скоринг адреса ---
# Хотя бы один из трёх нужен, чтобы в заключении была оценка риска адреса,
# а не только факты по цепочке.
#
# AMLBot: публичной спецификации нет, адрес запроса выдаётся вместе с доступом.
# Впишите его шаблоном; подставляются {address}, {asset} и {key}.
AMLBOT_API_KEY=
AMLBOT_API_URL=
# MistTrack: GET /v2/risk_score, ключ параметром. Самостоятельная регистрация.
MISTTRACK_API_KEY=
# Chainalysis: корпоративный доступ, ключ в заголовке Token.
CHAINALYSIS_API_KEY=

# --- Кошелёк: факты по цепочке (возраст, обороты, баланс) ---
# TRON работает без ключа. Для ERC-20 нужен бесплатный ключ с etherscan.io.
TRONGRID_API_KEY=
ETHERSCAN_API_KEY=
AML_RISK_THRESHOLD=50

# --- Российский контрагент ---
# DaData: официальные сведения ЕГРЮЛ, статус отдельным полем.
# Бесплатный ключ на dadata.ru, 10 000 запросов в сутки. Заменяет прямой
# запрос к egrul.nalog.gov.ru, который из корпоративной сети часто не проходит.
DADATA_API_KEY=
# Контур.Фокус: расширенная карточка, красные и жёлтые факты, 115-ФЗ.
# Ключ выдаётся по договору, тариф — на focus.kontur.ru.
KONTUR_FOCUS_KEY=
# Коннекторов пока нет; записи в providers.yaml выключены.
# SPARK_API_KEY=
# SBIS_API_KEY=

# --- Иностранный контрагент ---
# GLEIF (реестр LEI) работает без ключа — трогать ничего не нужно.
# OpenCorporates без токена отвечает 401: бесплатный ключ на opencorporates.com.
OPENCORPORATES_API_TOKEN=

# --- Санкционный и PEP-скрининг ---
# Опорный режим: свой сервер yente рядом с сервисом, ключ не нужен.
# Поднимается вместе с сервисом: docker compose --profile sanctions up
# Адрес задаётся в config/providers.yaml (по умолчанию http://127.0.0.1:8001).
# Ключ нужен только для облачного api.opensanctions.org.
OPENSANCTIONS_API_KEY=
# В Docker сервис скрининга виден как http://yente:8000, на хосте —
# как http://127.0.0.1:8001. Пусто — берётся адрес из providers.yaml.
OPENSANCTIONS_BASE_URL=
SANCTIONS_TIMEOUT_S=15
# Порог совпадения наименования, с которого запись считается попаданием.
SANCTIONS_MATCH_THRESHOLD=0.75

# --- Загрузка: файл удаляется сразу после отчёта ---
UPLOAD_TMP_DIR=tmp/uploads
MAX_UPLOAD_MB=20
